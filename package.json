{
  "name": "gow-ragnarok",
  "displayName": "gow-ragnarok",
  "description": "Theme and virtual pet inspired by the game God of War - Ragnarok",
  "version": "0.1.7",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Ragnarok",
        "uiTheme": "vs-dark",
        "path": "./themes/ragnarok-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ragnarok-icons",
        "label": "Ragnarok Icons",
        "path": "./themes/ragnarok-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "mimir.summon",
        "title": "Mimir: Summon"
      },
      {
        "command": "mimir.drinkWater",
        "title": "Mimir: I drank water"
      },
      {
        "command": "mimir.takeBreak",
        "title": "Mimir: Take a break"
      },
      {
        "command": "mimir.endBreak",
        "title": "Mimir: End break early"
      },
      {
        "command": "mimir.remindBreak",
        "title": "Mimir: Remind me to take a break"
      }
    ],
    "configuration": {
      "title": "Mimir",
      "properties": {
        "mimir.breakReminderMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Minutes of work before Mimir asks you to take a break. 0 disables the reminder."
        },
        "mimir.breakMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Length of a break started with \"Take a break\". Files stay read-only until it ends."
        },
        "mimir.waterReminderMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 0,
          "description": "Minutes between water reminders. 0 disables the reminder."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "mimir",
          "title": "Mimir",
          "icon": "assets/mimir-head.png"
        }
      ]
    },
    "views": {
      "mimir": [
        {
          "type": "webview",
          "id": "mimir.pet",
          "name": "Mimir",
          "icon": "assets/mimir-head.png",
          "visibility": "visible"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
